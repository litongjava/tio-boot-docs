{
  "name": "tio-boot-docs",
  "version": "1.0.0",
  "description": "tio-boot-docs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs:check": "node scripts/audit-docs.mjs",
    "docs:check-ai": "node scripts/check-ai-artifacts.mjs",
    "docs:build": "node --max-old-space-size=8192 node_modules/vitepress/bin/vitepress.js build docs",
    "docs:clean-dev": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:test": "playwright test --config=playwright.config.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "wrangler": "^4.73.0",
    "vitepress": "^1.6.4"
  }
}
